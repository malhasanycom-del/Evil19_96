<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:padding="12dp" android:background="#1B1D23">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/channelName" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="16sp"
            android:maxLines="2"/>
        <TextView android:id="@+id/channelGroup" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#A6A9B2" android:textSize="12sp"/>
    </LinearLayout>
    <Button android:id="@+id/favoriteButton" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="☆" android:minWidth="48dp"/>
</LinearLayout>
